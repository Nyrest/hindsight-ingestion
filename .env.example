# Copy to .env and fill in. Never commit .env.

# --- Required (unless DISABLE_AUTH=true) ---
BASIC_AUTH_USERNAME=admin
BASIC_AUTH_PASSWORD=

# 32-byte secret used to encrypt stored credentials (AES-256-GCM).
# Generate with: openssl rand -hex 32
# Keep it safe: losing or changing it makes stored credentials unreadable.
CREDENTIAL_ENCRYPTION_KEY=

# --- Optional ---
# DISABLE_AUTH=true makes the WebUI and API accessible WITHOUT authentication.
DISABLE_AUTH=false

# External URL of this service (used for OAuth redirect URIs).
PUBLIC_URL=http://localhost:8080

MAX_CONCURRENT_TASKS=4
LOG_LEVEL=info
