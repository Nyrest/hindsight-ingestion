# Copy to .env and fill in. Never commit .env.

# --- Required (unless DISABLE_AUTH=true) ---
BASIC_AUTH_USERNAME=admin
BASIC_AUTH_PASSWORD=

# 32-byte secret used to encrypt stored credentials (AES-256-GCM).
# Generate with: openssl rand -hex 32
# Keep it safe: losing or changing it makes stored credentials unreadable.
CREDENTIAL_ENCRYPTION_KEY=

# --- Optional ---
# DISABLE_AUTH=true makes the WebUI and API accessible WITHOUT authentication.
DISABLE_AUTH=false

# Optional fixed external URL for OAuth; leave empty to use the current browser origin.
PUBLIC_URL=

MAX_CONCURRENT_TASKS=4
LOG_LEVEL=info
TZ=UTC
